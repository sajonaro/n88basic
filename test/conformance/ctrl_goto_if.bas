10 REM CTRL.GOTO / CTRL.IF / CTRL.THEN / CTRL.ELSE: a GOTO-driven loop,
20 REM IF/THEN/ELSE, and a THEN branch with no ELSE falling through.
30 I=1
40 IF I>3 THEN GOTO 90
50 PRINT I;
60 I=I+1
70 GOTO 40
80 REM unreachable
90 IF I=4 THEN PRINT "FOUR" ELSE PRINT "NOT FOUR"
100 IF 0 THEN PRINT "SKIPPED"
110 PRINT "AFTER"
120 END
