; Depends on n88basic only for the Display.op type the interpreter's display
; list is made of (basic/display.ml) — no third-party library, no I/O. It
; produces PNG bytes as an OCaml string; bin/ is the one that writes them to
; disk.
(library
 (name raster)
 ; Namespaced under the package: opam installs it as n88basic.raster.
 (public_name n88basic.raster)
 (libraries n88basic))
